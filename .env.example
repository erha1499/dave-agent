# 复制为 .env，在本机填写。不要提交真实密钥。
# 默认读取已有环境变量 DEEPSEEK_API_KEY，模型为 deepseek/deepseek-flash。
# DEEPSEEK_API_KEY=
# 切换模型时显式覆盖：
# MODEL_PROVIDER=deepseek
# MODEL_ID=deepseek-flash
# MODEL_API_KEY=

# 本地 CLI 仅使用数据库中预置的合成 QQ 身份；另一个客户为 TEST_USER2。
CLI_DEMO_USER=TEST_USER1

# Docker MySQL 8.4 模拟团购券数据库。密码请在本机生成，不提交。
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=13306
DB_NAME=dave_agent
DB_USER=dave_agent_read

# 内置只读评测工作台，共用上面的 MySQL；eval:init 会在本机生成独立密码。
EVAL_DB_USER=dave_agent_eval
EVAL_DB_PASSWORD=
EVAL_PORT=3001

# D1 模拟商家协商：after-sales:init 在本机生成独立密码；配置后 QQ/CLI 自动启用。
AFTER_SALES_DB_USER=dave_agent_after_sales
AFTER_SALES_DB_PASSWORD=

# QQ → Pi → 团购券业务入口。AppSecret 不要提交或写入日志。
QQBOT_APP_ID=
QQBOT_APP_SECRET=
# 逗号分隔的群 OpenID，不是 QQ 群号。为空时仅记录被拦截群的 OpenID，不回复。
QQ_ALLOWED_GROUPS=
## 输出默认为固定模板 Markdown；显式 text 可切回纯文本，不改变业务流程。
# QQ_REPLY_FORMAT=markdown

# 未设置时：本地默认 websocket；NODE_ENV=production 默认 webhook。
# 显式设置会覆盖环境默认；部署时不要保留不需要的覆盖值。
# QQ_TRANSPORT=websocket
# QQBOT_WEBHOOK_PORT=8080
# QQBOT_WEBHOOK_PATH=/qq/callback
