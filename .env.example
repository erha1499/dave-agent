# 复制为 .env，在本机填写。不要提交真实密钥。
# 默认读取已有环境变量 DEEPSEEK_API_KEY，模型为 deepseek/deepseek-flash。
# DEEPSEEK_API_KEY=
# 切换模型时显式覆盖：
# MODEL_PROVIDER=deepseek
# MODEL_ID=deepseek-flash
# MODEL_API_KEY=
# 正式 CLI / QQ / 网页每条消息或事件的实际模型 HTTP 上限（含重试，严格 1..64）。
# MODEL_TASK_HTTP_LIMIT=12
# 完整生成请求的本地预算单位（UTF-8字节+实际输出预留+1024）；不是精确Token。严格4096..262144。
# MODEL_CONTEXT_BUDGET_UNITS=65536
# 普通百炼生成候选：MODEL_PROVIDER=bailian，MODEL_ID=qwen3.7-plus-2026-05-26。
# 仅使用下面的 DASHSCOPE_API_KEY；北京按量接口，不使用 Token Plan。

# 业务架构：默认 atomic 保留基线；controller 启用 v2 单动作工具与宿主编排。
# 默认本地词项；Controller 可显式启用已接入的重排与事实支持候选。
# SUPPORT_ARCHITECTURE=atomic
# SUPPORT_CONTEXT_MODE=memory # memory | mysql; mysql requires Controller and conversation-state-setup.ts

# 知识服务：lexical 无远程检索调用；m4-support 仅兼容 controller。
# m4-support 使用 qwen3-rerank + 独立选择的支持判别模型，额外计费。
# binary 保留 A1 判别；typed 分类候选仅适用 m4-support，完整 C1 准入未过。
# 0.71 是兼容默认值；超时为整次知识查询上限，无自动重试或词项降级接收。
# KNOWLEDGE_MODE=lexical
# KNOWLEDGE_SUPPORT=binary
# KNOWLEDGE_SUPPORT_MODEL=configured # configured | deepseek-flash | deepseek-v4-pro | qwen3.7-plus-2026-05-26
# configured 沿用 MODEL_PROVIDER/ID；固定选择仅改变判别，不改变主 Agent。
# KNOWLEDGE_SUPPORT_PROMPT=v5 # v5 | v6; v6 only Controller + m4-support + typed, default remains v5
# KNOWLEDGE_QUERY_MODE=combined # combined | separated; separated only Controller + m4-support
# KNOWLEDGE_APPLICABILITY=model_only # model_only | declared (v1) | declared-v2 (SKU category candidate); declared modes only Controller + m4-support
# KNOWLEDGE_THRESHOLD=0.71
# KNOWLEDGE_TIMEOUT_MS=15000

# 百炼检索（离线对照及显式 m4-support）：密钥只保存在本机环境或 .env。
# 使用 text-embedding-v4（1024 维）及 qwen3-rerank。
# BASE_URL 使用账号所在地域的官方地址；兼容 /compatible-mode/v1 前缀。
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 生成候选目前仅审阅北京（dashscope.aliyuncs.com 或 {WorkspaceId}.cn-beijing.maas.aliyuncs.com）；
# 其他地域的检索接口配置仍保留，生成候选会拒绝未审阅的地域。

# 本地 CLI 仅使用数据库中预置的合成 QQ 身份；另一个客户为 TEST_USER2。
CLI_DEMO_USER=TEST_USER1

# Docker MySQL 8.4 模拟团购券数据库。密码请在本机生成，不提交。
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=13306
DB_NAME=dave_agent
DB_USER=dave_agent_read

# 内置只读评测工作台，共用上面的 MySQL；eval:init 会在本机生成独立密码。
EVAL_DB_USER=dave_agent_eval
EVAL_DB_PASSWORD=
EVAL_PORT=3001

# D1 模拟商家协商：after-sales:init 在本机生成独立密码；配置后 QQ/CLI 自动启用。
AFTER_SALES_DB_USER=dave_agent_after_sales
AFTER_SALES_DB_PASSWORD=

# D2 模拟退款：同一初始化命令生成，独立账号只允许模拟退款需要的列与表。
REFUND_DB_USER=dave_agent_refund
REFUND_DB_PASSWORD=

# QQ → Pi → 团购券业务入口。AppSecret 不要提交或写入日志。
QQBOT_APP_ID=
QQBOT_APP_SECRET=
# 逗号分隔的群 OpenID，不是 QQ 群号。为空时仅记录被拦截群的 OpenID，不回复。
QQ_ALLOWED_GROUPS=
## 输出默认为固定模板 Markdown；显式 text 可切回纯文本，不改变业务流程。
# QQ_REPLY_FORMAT=markdown
# 核验当前机器人的自定义按钮权限后设为 true；仅 Markdown 群回复生效。
# QQ_REPLY_BUTTONS=false

# 未设置时：本地默认 websocket；NODE_ENV=production 默认 webhook。
# 显式设置会覆盖环境默认；部署时不要保留不需要的覆盖值。
# QQ_TRANSPORT=websocket
# QQBOT_WEBHOOK_PORT=8080
# QQBOT_WEBHOOK_PATH=/qq/callback
