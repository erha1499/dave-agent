{
  "name": "dave-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A customer-support agent built on the Pi SDK with QQ WebSocket and Webhook ingress.",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/cli.ts",
    "qq": "node --env-file-if-exists=.env src/qq.ts",
    "qq:deploy": "NODE_ENV=production node --env-file-if-exists=.env src/qq.ts",
    "db:up": "docker compose up -d --wait --wait-timeout 150",
    "db:stop": "docker compose stop mysql",
    "qq:bind": "node --env-file-if-exists=.env scripts/bind-qq.ts",
    "after-sales:init": "node --env-file-if-exists=.env scripts/init-after-sales.ts",
    "check:merchant": "node --env-file-if-exists=.env scripts/merchant-db-check.ts && node --env-file-if-exists=.env scripts/merchant-agent-check.ts",
    "check:merchant-model": "node --env-file-if-exists=.env scripts/merchant-model-check.ts",
    "eval:init": "node --env-file-if-exists=.env scripts/init-evaluation.ts",
    "eval:serve": "node --env-file-if-exists=.env src/eval-server.ts",
    "check:eval": "node scripts/eval-check.ts",
    "check:eval-db": "node --env-file-if-exists=.env scripts/eval-db-check.ts",
    "check:business": "node --env-file-if-exists=.env scripts/coupon-db-check.ts && node --env-file-if-exists=.env scripts/coupon-agent-check.ts",
    "check:model": "node --env-file-if-exists=.env scripts/coupon-model-check.ts",
    "check": "node scripts/check.ts",
    "check:qq": "node scripts/qq-check.ts",
    "check:qq-agent": "node scripts/qq-agent-check.ts",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run check && npm run check:qq && npm run check:qq-agent && npm run check:eval"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@tencent-connect/qqbot-nodejs": "1.0.4",
    "mysql2": "3.24.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "7.0.2"
  }
}
